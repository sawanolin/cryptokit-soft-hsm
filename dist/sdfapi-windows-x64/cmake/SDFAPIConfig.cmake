get_filename_component(SDFAPI_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(SDFAPI_INCLUDE_DIR "${SDFAPI_ROOT}/include")
set(SDFAPI_LIBRARY "${SDFAPI_ROOT}/lib/sdfapi_x64.lib")

if(NOT TARGET SDFAPI::SDFAPI)
    add_library(SDFAPI::SDFAPI SHARED IMPORTED)
    set_target_properties(SDFAPI::SDFAPI PROPERTIES
        IMPORTED_IMPLIB "${SDFAPI_LIBRARY}"
        IMPORTED_LOCATION "${SDFAPI_ROOT}/bin/sdfapi_x64.dll"
        INTERFACE_INCLUDE_DIRECTORIES "${SDFAPI_INCLUDE_DIR}"
    )
endif()
